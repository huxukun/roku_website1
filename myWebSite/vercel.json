{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/api/sb/:path*",
      "destination": "https://dzwdadwmhnwnytrfxgzu.supabase.co/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/sb/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
